#!/bin/bash
# Live preview for IDUI Test 04.
#
#   ./preview                 first frozen seed, composition 1
#   ./preview 12345           that seed
#   ./preview 12345 4         that seed, composition 4
#
# Keys once the window is up:
#   left / right   previous / next seed
#   [ / ]          previous / next composition
#   space          pause          r   reset motion to the start
#   s              save a 5120x2880 still of the exact frame on screen
#   q              quit
set -euo pipefail
cd "$(dirname "$0")"
swift build -c release --product BettaTest04 >/dev/null
exec "$(swift build -c release --show-bin-path)/BettaTest04" --preview "$@"
