# r17 shell cutover. / is the app; the hash names the page (#fnb, #messages,
# #brand, #settings/me ...). Every address the legacy shell ever handed out
# lands on its hash route so old bookmarks, push routes and shared links keep
# working. Browsers carry a request fragment over a 301 whose Location has
# none, which is how /next#signin?i=..&c=.. and /login.html#i=..&c=.. arrive
# intact for shell.js to translate.
/next / 301
/next.html / 301
/login.html / 301
/login / 301
/guidance / 301
/details / 301
/fnb/:slug /#fnb/:slug 301
/fnb /#fnb 301
/brand /#brand 301
/hotel-factsheet /#brand/factsheet 301
/ihg-history /#brand/history 301
/messages /#messages 301
/settings /#settings/me 301
/account /#settings/me 301
/account.html /#settings/me 301
/admin /#settings/admin 301
/admin.html /#settings/admin 301
