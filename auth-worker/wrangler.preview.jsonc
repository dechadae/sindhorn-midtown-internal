{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sindhorn-midtown-auth-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "ACTIVATION_PEPPER",
      "BREVO_API_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sindhorn-midtown-alerts-db",
      "database_id": "4a8f9393-b35d-4f17-a907-b687412042d7"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://sjpvhgxacsiorrtijqua.supabase.co",
    "ALLOWED_ORIGIN": "https://sindhorn-midtown-internal.pages.dev",
    "PREVIEW_MODE": "true",
    "BREVO_SENDER_EMAIL": "decha.kokaew@ihg.com",
    "BREVO_SENDER_NAME": "Sindhorn Midtown Internal"
  }
}
